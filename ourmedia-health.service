[Unit]
Description=ourMedia health probe (writes health_state.json, logs DOWN transitions)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=plex
Group=plex
WorkingDirectory=/home/plex/Documents/github/ourMedia
Environment=OURMEDIA_DATA_DIR=/home/plex/.bockmedia
ExecStart=/usr/bin/python3 /home/plex/Documents/github/ourMedia/scripts/health_check.py
