# macOS / Xcode user state
.DS_Store
**/.DS_Store
**/xcuserdata/
*.xcuserstate
*.xcschememanagement.plist

# iOS local build config (copy from Config.xcconfig.example)
ios/Config.xcconfig
ios/build/

# Runtime state (auto-generated, not committed)
*.bak
nowplaying_state.json
streaming_history.jsonl
queues.json
automations.json
favorites.json
device_groups.json
selected_state.json
ignored_tracks.json
server.log
server.log.*
msp_slu_poll.log
cron-ask.log
cron-catalog.log
plex-sync.log
tunnel.log
health.log
health_state.json

# Local secrets (use *.example.json templates)
config.json
skill/account-linking.json

# Extracted / cached artwork (can be regenerated)
artwork_cache/

# Alexa skill test payloads with real tokens / user IDs
skill/launch-request.json
skill/misrouted-playtrack-request.json
skill/play-yacht-request.json

# Systemd unit (machine-specific, tracked separately)
ourmedia.service

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node / UI tests
tests/ui/node_modules/
tests/ui/package-lock.json

# Android
android/local.properties
android/keystore.properties
android/release.keystore
android/*.keystore
android/.gradle/
android/.kotlin/
android/app/build/
android/build/
android/.idea/
android/*.iml

# Editor
.cursor/
*.swp
