# Example systemd unit for Bock Media backend.
# Copy to the server: sudo cp deploy/systemd/ourmedia.service.example /etc/systemd/system/ourmedia.service
#
# For router port-forward (public IP:3001 -> this host), gunicorn MUST bind 0.0.0.0:3001.
# Binding 127.0.0.1 only works with Cloudflare tunnel, not direct port-forward.

[Unit]
Description=Bock Media Flask backend
After=network.target

[Service]
Type=simple
User=bockmedia
Group=bockmedia
WorkingDirectory=/opt/bock-media
Environment=PORT=3001
Environment=OURMEDIA_DB_PATH=/var/lib/bockmedia/songs_cache.db
Environment=OURMEDIA_DATA_DIR=/var/lib/bockmedia
Environment=OURMEDIA_MUSIC_ROOT=/var/lib/bockmedia/music
# Required for automations / Alexa remote — must match your custom skill id (Alexa Developer Console).
Environment=OURMEDIA_SKILL_ID=amzn1.ask.skill.YOUR_CUSTOM_SKILL_ID
ExecStart=/usr/bin/python3 -m gunicorn \
    --bind 0.0.0.0:3001 \
    --workers 1 \
    --timeout 120 \
    --access-logfile - \
    server:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
